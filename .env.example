NODE_ENV=development
# Neon pooled URI — Worker (wrangler) and `pnpm db:migrate` both use this.
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
# Browser origin: Vite on :5173 proxies /api /rpc /health to wrangler on :3100.
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Production custom domain:
#   WEB_ORIGIN=https://app.groxbot.com
#   BETTER_AUTH_URL=https://api.groxbot.com
# Staging (Cloudflare Workers, no custom domain):
#   landing  https://groxbot-landing.qalam.workers.dev
#   web      https://groxbot-web.qalam.workers.dev
#   api      https://groxbot-api.qalam.workers.dev
CORS_ORIGINS=https://groxbot-web.qalam.workers.dev,https://groxbot-landing.qalam.workers.dev
# Google OAuth. Local: http://127.0.0.1:5173/api/auth/callback/google
# Staging: https://groxbot-api.qalam.workers.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Magic-link email: Worker send_email binding (`EMAIL`) + from address.
EMAIL_FROM=Groxbot <noreply@groxbot.com>
# Hosted models: Worker AI binding. Optional AI Gateway id for observability.
# CLOUDFLARE_AI_GATEWAY_ID=default
# Node self-host fallback only (REST gateway, not used on the Worker):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_TOKEN=
# Node self-host later. Unused on the Worker path.
WORKER_URL=
WORKER_PORT=3101
GUEST_URL=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_PROVIDER=fake
COMPOSIO_API_KEY=
E2B_API_KEY=
LOG_LEVEL=info
