NODE_ENV=development
# Neon pooled URI — Worker (wrangler) and `pnpm db:migrate` both use this.
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
# Office is Vite on :5173. Auth, oRPC, and Think talk to wrangler on :3100.
BETTER_AUTH_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Production custom domain:
#   WEB_ORIGIN=https://app.groxbot.com
#   BETTER_AUTH_URL=https://api.groxbot.com
# Staging (Cloudflare Workers, no custom domain):
#   landing  https://groxbot-landing.qalam.workers.dev
#   web      https://groxbot-web.qalam.workers.dev
#   api      https://groxbot-api.qalam.workers.dev
CORS_ORIGINS=https://groxbot-web.qalam.workers.dev,https://groxbot-landing.qalam.workers.dev
# Google OAuth. Local: http://127.0.0.1:3100/api/auth/callback/google
# Staging: https://groxbot-api.qalam.workers.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Magic-link email: Worker send_email binding (`EMAIL`) + from address.
EMAIL_FROM=Groxbot <noreply@mail.groxbot.com>
# Hosted models: proprietary grox-gateway (Polar + CF AI Gateway), or Worker AI binding.
# GROX_GATEWAY_URL=https://gateway.groxbot.com
# GROX_GATEWAY_SECRET=<same as grox-gateway GATEWAY_SECRET>
# CLOUDFLARE_AI_GATEWAY_ID=default
# Node self-host fallback only (REST gateway, not used on the Worker):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_TOKEN=
# Node self-host later. Unused on the Worker path.
WORKER_URL=
WORKER_PORT=3101
GUEST_URL=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
COMPOSIO_API_KEY=
# Comma-separated TinyFish pool (round-robin; 30 req/min per key). Single key still works.
TINYFISH_API_KEYS=
TINYFISH_API_KEY=
LOG_LEVEL=info
# Polar (hosted groxbot.com only — leave unset for self-host)
# Plan limits and Polar product ids live in Postgres `billing_plans`, not here.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ENVIRONMENT=production
# GROX_GATEWAY_URL=https://gateway.groxbot.com
# GROX_GATEWAY_SECRET=<same as grox-gateway GATEWAY_SECRET>
# Worker KV for global product cache (model_pricing). Local dev uses wrangler preview ids.
# Production: wrangler kv namespace create PRODUCT_CACHE
#             wrangler kv namespace create PRODUCT_CACHE --preview
