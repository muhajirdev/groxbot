{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "*.json",
      "!**/routeTree.gen.ts",
      "!**/dist",
      "!**/.output",
      "!apps/landing/src/data/composio-toolkits.json",
      "!packages/app-runtime/src/generated/**",
      "!packages/app-runtime/vendor/**"
    ]
  }
}
