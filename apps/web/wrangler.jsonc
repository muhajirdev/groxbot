{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groxbot-web",
  // Office SPA at app.whip.computer (app.groxbot.com still attached). Account is Muhajir (qalam.workers.dev).
  "account_id": "67f961331110b81774851ee4f54349b9",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "routes": [
    { "pattern": "app.whip.computer", "custom_domain": true },
    { "pattern": "app.groxbot.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
