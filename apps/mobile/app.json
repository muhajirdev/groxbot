{
  "expo": {
    "name": "Groxbot",
    "slug": "groxbot",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "groxbot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.groxbot.mobile"
    },
    "android": {
      "package": "dev.groxbot.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo to this teammate’s computer."
        }
      ],
      "expo-sharing"
    ]
  }
}
