{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groxbot-api",
  "main": "src/worker.ts",
  "account_id": "67f961331110b81774851ee4f54349b9",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.whip.computer",
      "custom_domain": true
    },
    {
      "pattern": "api.groxbot.com",
      "custom_domain": true
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 3100,
    "local_protocol": "http"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_RUNTIME",
        "class_name": "AppRuntime"
      },
      {
        "name": "ROOM_ACTOR",
        // SQLite class is still the v1 BotActor. versions upload cannot
        // apply new_sqlite_classes / deleted_classes (API 10211).
        "class_name": "BotActor"
      }
    ]
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BotActor"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AppRuntime"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE",
      "bucket_name": "groxbot-knowledge"
    }
  ],
  "d1_databases": [
    {
      // Hosted catalog. Local wrangler still uses --local under .wrangler/state.
      "binding": "DB",
      "database_name": "groxbot",
      "database_id": "7402e840-25b5-4be0-a5c3-96626a7956bc",
      "migrations_dir": "../../packages/db/drizzle",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      // Production: wrangler kv namespace create PRODUCT_CACHE (and --preview)
      "binding": "PRODUCT_CACHE",
      "id": "3f01d40153a842d7bfd3d28193b8b2d3",
      "preview_id": "f6889f40e60c48408e7a9e2c085b99a6"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://api.whip.computer",
    "API_URL": "https://api.whip.computer",
    "WEB_ORIGIN": "https://app.whip.computer",
    "LANDING_ORIGIN": "https://whip.computer",
    "CORS_ORIGINS": "https://app.whip.computer,https://admin.whip.computer,https://whip.computer,https://www.whip.computer,https://app.groxbot.com,https://admin.groxbot.com,https://groxbot.com,https://www.groxbot.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "groxbot://,groxbot-ios://,exp://,exp+groxbot://",
    "EMAIL_FROM": "Groxbot <noreply@mail.groxbot.com>",
    "POLAR_ENVIRONMENT": "production",
    "GROXBOT_CODEX_PROXY_URL": "https://groxbot-codex.fly.dev"
  }
}
