{
  "name": "groxbot",
  "private": true,
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@groxbot/api --filter=@groxbot/web",
    "dev:landing": "turbo dev --filter=@groxbot/landing",
    "deploy:landing": "pnpm --filter @groxbot/landing run deploy",
    "deploy:web": "pnpm --filter @groxbot/web run deploy",
    "deploy:api": "pnpm --filter @groxbot/api run deploy",
    "dev:desktop": "turbo dev --filter=@groxbot/api --filter=@groxbot/web --filter=@groxbot/desktop",
    "dev:mobile": "pnpm --filter @groxbot/mobile start",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @groxbot/db generate",
    "db:migrate": "pnpm --filter @groxbot/db migrate",
    "db:push": "pnpm --filter @groxbot/db push",
    "guest": "pnpm --filter @groxbot/guest start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "wrangler": "^4.127.1"
    }
  }
}
